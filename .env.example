# ============================================================
# PawDerm AI — Supabase Configuration Example
# ============================================================
# Sao chép file này thành .env và điền thông tin từ Supabase:
# Supabase Dashboard → Settings → API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Gửi mã OTP xác thực Gmail khi đăng ký
# ============================================================
# 1. Bật Xác minh 2 bước cho tài khoản Gmail dùng để GỬI mail:
#    https://myaccount.google.com/security
# 2. Tạo "Mật khẩu ứng dụng" (App Password) 16 ký tự:
#    https://myaccount.google.com/apppasswords
# Để trống => chế độ DEV: mã OTP được in ra console của backend.
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Domain frontend khi deploy (phân cách bằng dấu phẩy)
# ALLOWED_ORIGINS=https://pawderm.vercel.app
